{
  "name": "video-meetings",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@video-meetings/web\" \"npm run dev --workspace=@video-meetings/api\"",
    "dev:web": "npm run dev --workspace=@video-meetings/web",
    "dev:api": "npm run dev --workspace=@video-meetings/api",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": { "concurrently": "^9.1.2", "prettier": "^3.5.3" }
}
